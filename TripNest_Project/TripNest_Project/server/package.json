{
  "name": "tripnest-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test tests/*.test.js",
    "db:start": "node scripts/start-db.js",
    "db:setup": "node --env-file=.env scripts/setup-db.js",
    "db:migrate": "node --env-file=.env scripts/migrate-finance.js",
    "db:bookings": "node --env-file=.env scripts/migrate-bookings.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "supertest": "7.3.0"
  }
}
