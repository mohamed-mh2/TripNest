# Use a local PostgreSQL database that you created for this project.
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/tripnest
JWT_SECRET=replace-with-a-long-random-secret-for-your-local-demo
NODE_ENV=development
DEMO_MODE=true
PORT=3001

# Hosted deployment: Render supplies DATABASE_URL and a generated JWT_SECRET.
# NODE_ENV=production
# HOST=0.0.0.0
# AUTO_MIGRATE=true
# TRUST_PROXY=1
# ADMIN_EMAIL=your-admin-email@example.com
# ADMIN_SETUP_SECRET=generated-private-value-at-least-32-characters
